# =============================================
#  KONFIGURASI SERVER
# =============================================
PORT=3000
NODE_ENV=development

# =============================================
#  KONFIGURASI DATABASE MySQL / MariaDB
# =============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=db_inventaris

# Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# =============================================
#  KONFIGURASI CORS
# =============================================
# Pisahkan beberapa origin dengan koma
CORS_ORIGIN=http://localhost,http://localhost:5500,http://127.0.0.1:5500

# =============================================
#  KONFIGURASI JWT / SESSION (opsional)
# =============================================
JWT_SECRET=ganti_dengan_secret_key_yang_kuat_dan_panjang
JWT_EXPIRES_IN=24h

# =============================================
#  KONFIGURASI EMAIL NOTIFIKASI (Fitur 2)
# =============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=email.gudang.anda@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM_NAME=Sistem Inventaris Gudang
LOGISTIK_EMAIL=tim.logistik@perusahaan.com

# =============================================
#  KONFIGURASI SSE
# =============================================
SSE_RETRY_MS=3000
SSE_HEARTBEAT_MS=30000
